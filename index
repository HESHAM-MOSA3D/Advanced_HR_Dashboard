<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HR Analytics Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
  :root {
    --bg:        #0f1117;
    --surface:   #181c27;
    --surface2:  #1e2333;
    --border:    rgba(255,255,255,0.07);
    --border2:   rgba(255,255,255,0.12);
    --text:      #e8eaf0;
    --muted:     #7a7f96;
    --accent:    #4f8ef7;
    --accent2:   #22d3a5;
    --red:       #f05a5a;
    --amber:     #f5a623;
    --purple:    #9b7ff4;
    --pink:      #f06292;
    --font:      'DM Sans', sans-serif;
    --mono:      'DM Mono', monospace;
    --radius:    12px;
    --radius-sm: 8px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    font-family: var(--font);
    color: var(--text);
    min-height: 100vh;
    font-size: 14px;
    line-height: 1.6;
  }

  /* ── layout ── */
  .layout { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }

  /* ── sidebar ── */
  .sidebar {
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 2rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 0;
    height: 100vh;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .logo-mark {
    width: 34px; height: 34px;
    background: var(--accent);
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 500; font-size: 15px; color: #fff;
  }

  .logo-text { font-size: 15px; font-weight: 500; letter-spacing: -.01em; }
  .logo-text span { color: var(--muted); font-weight: 300; }

  nav { display: flex; flex-direction: column; gap: 2px; }

  .nav-section {
    font-size: 10px;
    font-family: var(--mono);
    letter-spacing: .1em;
    color: var(--muted);
    text-transform: uppercase;
    padding: 1rem 0 .4rem .5rem;
  }

  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: .55rem .75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background .15s;
    color: var(--muted);
    font-size: 13.5px;
    text-decoration: none;
  }

  .nav-item:hover { background: var(--surface2); color: var(--text); }
  .nav-item.active { background: rgba(79,142,247,.12); color: var(--accent); }

  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .user-chip {
    display: flex; align-items: center; gap: 10px;
  }

  .avatar-sm {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--purple));
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 500; color: #fff; flex-shrink: 0;
  }

  .user-name { font-size: 13px; font-weight: 500; }
  .user-role { font-size: 11px; color: var(--muted); }

  /* ── main ── */
  .main { padding: 2rem 2.25rem; overflow-x: hidden; }

  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 2rem;
  }

  .page-title { font-size: 22px; font-weight: 500; letter-spacing: -.02em; }
  .page-sub { font-size: 13px; color: var(--muted); margin-top: 2px; }

  .topbar-right { display: flex; align-items: center; gap: 10px; }

  .btn {
    display: flex; align-items: center; gap: 6px;
    padding: .5rem 1rem;
    border-radius: var(--radius-sm);
    font-family: var(--font);
    font-size: 13px;
    cursor: pointer;
    border: 1px solid var(--border2);
    background: var(--surface2);
    color: var(--text);
    transition: background .15s, border-color .15s;
  }

  .btn:hover { background: #252b3d; border-color: rgba(255,255,255,.18); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: #3a7de8; }

  .badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 20px;
    font-size: 11px; font-weight: 500; font-family: var(--mono);
  }

  .badge-green { background: rgba(34,211,165,.12); color: var(--accent2); }
  .badge-red   { background: rgba(240,90,90,.12);  color: var(--red); }
  .badge-amber { background: rgba(245,166,35,.12); color: var(--amber); }
  .badge-blue  { background: rgba(79,142,247,.12); color: var(--accent); }

  /* ── metric cards ── */
  .metrics {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 1.5rem;
  }

  .mc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    position: relative;
    overflow: hidden;
    transition: border-color .2s;
  }

  .mc:hover { border-color: var(--border2); }

  .mc::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 2px;
  }

  .mc.blue::before  { background: var(--accent); }
  .mc.green::before { background: var(--accent2); }
  .mc.red::before   { background: var(--red); }
  .mc.amber::before { background: var(--amber); }
  .mc.purple::before{ background: var(--purple); }

  .mc-label { font-size: 11px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .6rem; }
  .mc-val   { font-size: 26px; font-weight: 500; letter-spacing: -.02em; line-height: 1; }
  .mc-delta { font-size: 12px; margin-top: .5rem; display: flex; align-items: center; gap: 4px; }
  .mc-delta.up { color: var(--accent2); }
  .mc-delta.dn { color: var(--red); }

  /* ── charts row ── */
  .row2 { display: grid; grid-template-columns: 1.4fr 1fr; gap: 14px; margin-bottom: 14px; }
  .row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  .row-full { margin-bottom: 14px; }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
  }

  .card-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 1.2rem;
  }

  .card-title { font-size: 13px; font-weight: 500; color: var(--text); }
  .card-sub   { font-size: 11px; color: var(--muted); margin-top: 2px; }

  .legend {
    display: flex; flex-wrap: wrap; gap: 14px;
    font-size: 11.5px; color: var(--muted);
    margin-bottom: 1rem;
  }

  .legend span { display: flex; align-items: center; gap: 5px; }
  .legend b    { width: 10px; height: 10px; border-radius: 2px; display: inline-block; flex-shrink: 0; }

  /* ── bar rows ── */
  .bar-row { margin-bottom: 11px; }
  .bar-row:last-child { margin-bottom: 0; }
  .bar-top { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); margin-bottom: 5px; }
  .bar-top span:last-child { color: var(--text); font-family: var(--mono); }
  .bar-track { height: 6px; background: var(--surface2); border-radius: 3px; overflow: hidden; }
  .bar-fill  { height: 100%; border-radius: 3px; transition: width .6s cubic-bezier(.4,0,.2,1); }

  /* ── status boxes ── */
  .status-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

  .st-box {
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    padding: .8rem .9rem;
  }

  .st-val  { font-size: 22px; font-weight: 500; line-height: 1; font-family: var(--mono); }
  .st-lbl  { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .st-dot  { width: 6px; height: 6px; border-radius: 50%; display: inline-block; margin-right: 5px; vertical-align: 1px; }

  /* ── table ── */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  thead th {
    font-size: 11px; font-family: var(--mono); text-transform: uppercase;
    letter-spacing: .06em; color: var(--muted);
    padding: .5rem .75rem; text-align: left;
    border-bottom: 1px solid var(--border);
  }
  tbody tr { transition: background .12s; }
  tbody tr:hover { background: rgba(255,255,255,.02); }
  tbody td {
    padding: .7rem .75rem; font-size: 13px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  tbody tr:last-child td { border-bottom: none; }

  .emp-cell { display: flex; align-items: center; gap: 10px; }
  .avatar-xs {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 500;
  }

  /* ── score bar ── */
  .score-bar { display: flex; align-items: center; gap: 8px; }
  .score-track { flex: 1; height: 4px; background: var(--surface2); border-radius: 2px; overflow: hidden; }
  .score-fill  { height: 100%; border-radius: 2px; }
  .score-num   { font-size: 12px; font-family: var(--mono); color: var(--muted); min-width: 30px; }

  /* ── doughnut center ── */
  .donut-wrap { position: relative; }
  .donut-center {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center; pointer-events: none;
  }
  .donut-center .big { font-size: 22px; font-weight: 500; font-family: var(--mono); }
  .donut-center .sm  { font-size: 10px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: .06em; }

  /* ── scrollbar ── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 3px; }

  /* ── animations ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .mc    { animation: fadeUp .4s ease both; }
  .mc:nth-child(1) { animation-delay: .05s; }
  .mc:nth-child(2) { animation-delay: .10s; }
  .mc:nth-child(3) { animation-delay: .15s; }
  .mc:nth-child(4) { animation-delay: .20s; }
  .mc:nth-child(5) { animation-delay: .25s; }
  .card  { animation: fadeUp .45s .1s ease both; }
</style>
</head>
<body>

